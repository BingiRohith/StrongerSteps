# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.production.local
.env.test.local
.env.*
!.env.example

# Runtime uploads contain site content and protected downloads, not source code.
public/uploads/
private-uploads/

# Next.js
.next/
out/

# User-uploaded media (Sprint 19.6) — runtime content, not source; also
# breaks on serverless/multi-instance deploys (see docs/09_DEPLOYMENT.md).
# .gitkeep placeholders are explicitly re-added below so empty upload
# subdirectories still exist on a fresh checkout.
public/uploads/*
private-uploads/*
!public/uploads/**/.gitkeep
!private-uploads/**/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Claude Code
.claude/
